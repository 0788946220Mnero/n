# ═══ قاعدة البيانات ═══
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/diyar

# ═══ النطاقات المسموحة (CORS) — مفصولة بفواصل، بلا شرطة في النهاية ═══
# النطاقات الأساسية مضمّنة في الكود أصلاً؛ أضف هنا أي نطاق إضافي فقط
CLIENT_URL=https://diyaralanbat.com,https://www.diyaralanbat.com,https://diyaradmin.netlify.app

# ═══ التوكنات ═══
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_EXPIRES_IN=90d

# ═══ أدمن افتراضي عند أول إقلاع ═══
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام
# رقم هاتف المدير — مطلوب لعمل "نسيت كلمة المرور"
ADMIN_PHONE=0791234567

# ═══ Cloudinary ═══
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=diyar-alanbat

# ═══ الطباعة (QZ Tray) ═══
PRINT_TOKEN=
PRINT_PRIVATE_KEY_BASE64=

# ═══ رموز التحقق OTP: dev | twilio | firebase ═══
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ═══ إشعارات FCM (اختياري) ═══
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

NODE_ENV=production
